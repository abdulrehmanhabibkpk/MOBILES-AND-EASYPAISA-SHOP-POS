# ==============================================================================
# Balal Mobile Shop - Apache / cPanel / hPanel .htaccess configuration
# ==============================================================================

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Pass Authorization Header to PHP
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # React Single Page App (SPA) fallback:
    # If the requested file or directory does not exist, and is NOT in /api/
    # then route to index.html so refreshing pages works seamlessly
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} !^/api/
    RewriteCond %{REQUEST_URI} !^.*\.php$
    RewriteRule ^ index.html [L]

    # Prevent directory indexing
    Options -Indexes
</IfModule>

# Set CORS Headers
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
    Header set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With, X-Shop-Secret"
</IfModule>

# PHP Execution & Character Encoding
AddDefaultCharset UTF-8
